<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTN.appMovil.MestroDetalle.Views.ProductosPage"
             Title="Gestión de Productos">
    <ScrollView>
        <VerticalStackLayout Padding="30,30" Spacing="15">
            
            <Label Text="Seleccionar Producto Existente" FontSize="16" FontAttributes="Bold" />
            <Picker x:Name="pickerProductos" Title="Elige un producto..." SelectedIndexChanged="OnProductoSelected" ItemDisplayBinding="{Binding Nombre}" />

            <BoxView HeightRequest="1" Color="Gray" Margin="0, 10" />

            <Label Text="Detalles del Producto" FontSize="16" FontAttributes="Bold" />
            
            <Label Text="Categoría (Maestro):" FontSize="14" />
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Picker Grid.Column="0" x:Name="pickerCategoriaProducto" Title="Elige Categoría..." ItemDisplayBinding="{Binding Nombre}" />
                <Button Grid.Column="1" Text="+ Nueva" Clicked="BtnMostrarNuevaCat_Clicked" />
            </Grid>

            <!-- Panel oculto para crear categoría en línea -->
            <VerticalStackLayout x:Name="panelNuevaCategoria" IsVisible="False" BackgroundColor="#f0f0f0" Padding="10" Margin="0,5,0,10">
                <Label Text="Crear Categoría Rápida" FontAttributes="Bold" />
                <Entry x:Name="txtNuevaCatNombre" Placeholder="Nombre Categoría" />
                <Entry x:Name="txtNuevaCatDesc" Placeholder="Descripción" />
                <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                    <Button Text="Guardar" Clicked="BtnGuardarNuevaCat_Clicked" BackgroundColor="Green" TextColor="White" />
                    <Button Text="Cancelar" Clicked="BtnCancelarNuevaCat_Clicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Entry x:Name="txtProdNombre" Placeholder="Nombre del Producto" />
            <Entry x:Name="txtProdPrecio" Placeholder="Precio" Keyboard="Numeric" />
            
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
                <Button Text="Crear" Clicked="BtnProdCrear_Clicked" BackgroundColor="Green" TextColor="White" />
                <Button Text="Actualizar" Clicked="BtnProdActualizar_Clicked" BackgroundColor="Orange" TextColor="White" />
                <Button Text="Borrar" Clicked="BtnProdBorrar_Clicked" BackgroundColor="Red" TextColor="White" />
            </HorizontalStackLayout>
            <Button Text="Limpiar Selección" Clicked="BtnLimpiar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
