<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTN.appMovil.MestroDetalle.MainPage"
             Title="Menú Principal">

    <ScrollView>
        <VerticalStackLayout Padding="30,30" Spacing="25" VerticalOptions="Center">
            
            <Label Text="Sistema de Panadería" 
                   Style="{StaticResource Headline}" 
                   HorizontalOptions="Center" />

            <Button Text="Gestión de Categorías" 
                    Clicked="BtnCategorias_Clicked" 
                    HeightRequest="60" 
                    FontSize="18" />

            <Button Text="Gestión de Productos" 
                    Clicked="BtnProductos_Clicked" 
                    HeightRequest="60" 
                    FontSize="18" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
